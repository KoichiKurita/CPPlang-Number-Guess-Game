{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Ninja, Debug)",
      "description": "Local development build. Warnings are reported but do not fail the build.",
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "ci",
      "displayName": "CI (Ninja, Debug, warnings as errors)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "NGG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Sanitizers (Ninja, Debug, ASan + UBSan)",
      "description": "GCC/Clang on Linux or macOS only.",
      "inherits": "ci",
      "cacheVariables": {
        "NGG_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "qt",
      "displayName": "Qt GUI (Ninja, Debug, warnings as errors)",
      "description": "Builds the console app, the Qt GUI and all tests. Requires Qt6.",
      "inherits": "ci",
      "cacheVariables": {
        "NGG_BUILD_QT": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Ninja, Debug, Qt GUI, gcov)",
      "description": "Instrumented build for code coverage. GCC/Clang only. Requires Qt6.",
      "inherits": "qt",
      "cacheVariables": {
        "NGG_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "clang-tidy (Ninja, Debug, Qt GUI, static analysis)",
      "description": "Runs clang-tidy on project sources while compiling. Requires clang-tidy and Qt6.",
      "inherits": "qt",
      "cacheVariables": {
        "NGG_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzing (Ninja, Clang, libFuzzer + ASan + UBSan)",
      "description": "Builds the fuzz targets and the tests with Clang. Linux or macOS only.",
      "inherits": "ci",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "NGG_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja, Release, Qt GUI, warnings as errors)",
      "description": "Optimized build used for distribution packages. Requires Qt6.",
      "inherits": "qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio, warnings as errors)",
      "description": "Uses the newest installed Visual Studio generator.",
      "inherits": "base",
      "cacheVariables": {
        "NGG_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",  "configurePreset": "dev" },
    { "name": "ci",   "configurePreset": "ci" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "qt",   "configurePreset": "qt" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "release", "configurePreset": "release" },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev",  "inherits": "base", "configurePreset": "dev" },
    { "name": "ci",   "inherits": "base", "configurePreset": "ci" },
    { "name": "qt",   "inherits": "base", "configurePreset": "qt" },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" },
    { "name": "fuzz", "inherits": "base", "configurePreset": "fuzz" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    { "name": "msvc", "inherits": "base", "configurePreset": "msvc", "configuration": "Debug" }
  ]
}
